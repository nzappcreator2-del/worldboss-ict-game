# Loaded only by `npm run dev:emulator` (vite --mode emulator). Points the two
# Firebase clients at the local emulator suite instead of the live project.
# Contains no secrets. A production build ignores this file entirely — the
# emulator branch is compiled out by the import.meta.env.DEV guard in
# src/firebase/emulator.ts.
VITE_FIREBASE_EMULATOR=1
